# ===========================================================================
# WeatherGPT Environment Configuration Template (.env.example)
# ===========================================================================
# Copy this file to '.env' and modify variables to customize runtime behavior:
#   cp .env.example .env
# ===========================================================================

# ---------------------------------------------------------------------------
# 1. System Execution Mode
# ---------------------------------------------------------------------------
# WEATHER_MODE:
#   'mock' : Uses deterministic SIH disaster presets (Jalandhar Heavy Rain,
#            Bathinda High Wind, Amritsar Heatwave). Ideal for offline hackathon demos.
#   'live' : Connects to Open-Meteo live API for real-time global weather.
WEATHER_MODE=mock

# CALENDAR_PROVIDER:
#   'mock'   : In-memory calendar simulator (no Google credentials needed).
#   'google' : Synchronizes real events via Google Calendar API.
CALENDAR_PROVIDER=mock

# Default starting location (e.g. Jalandhar, Bathinda, Amritsar, Ludhiana)
DEFAULT_LOCATION=Jalandhar

# Log verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Comma-separated list of allowed CORS origins for web frontends in production
# (Default allows localhost:3000, localhost:5173, localhost:8000)
# CORS_ORIGINS=https://app.weathergpt.example.com,https://dashboard.weathergpt.example.com
CORS_ORIGINS=

# Optional API Key for securing farmer profiles and alert logs in production
# When set, requests to /api/farmers and /api/alerts require X-API-Key or Authorization: Bearer <key>
API_KEY=



# ---------------------------------------------------------------------------
# 2. Agronomic Hazard Thresholds (Optional overrides)
# ---------------------------------------------------------------------------
# RAIN_CRITICAL_MM=50.0
# RAIN_HIGH_MM=25.0
# RAIN_MEDIUM_MM=12.0
# WIND_SPRAY_LIMIT_KMH=15.0
# HEAT_STRESS_C=38.0
# FROST_HIGH_C=4.0


# ---------------------------------------------------------------------------
# 3. External Integration Credentials (Required only if live mode is enabled)
# ---------------------------------------------------------------------------
# Google Calendar API service account JSON path
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CALENDAR_ID=primary

# Database Connection URL (Member 6)
DATABASE_URL=sqlite:///./weathergpt.db

# Optional Conversational AI API Keys (e.g. Google Gemini)
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# 4. Outbound Farmer SMS Configuration (Vonage / Mock)
# ---------------------------------------------------------------------------
# SMS_ENABLED:
#   'false' : Safe default. No SMS sent; alerts are queued or recorded as simulated.
#   'true'  : Attempts outbound SMS delivery via configured SMS_PROVIDER.
SMS_ENABLED=false

# SMS_PROVIDER:
#   'mock'   : Safe in-memory simulated SMS provider for development and tests.
#   'vonage' : Vonage (Nexmo) SMS REST API (https://developer.vonage.com).
SMS_PROVIDER=mock

# Vonage API Key and Secret (keep blank by default)
VONAGE_API_KEY=
VONAGE_API_SECRET=

# Optional SMS Sender ID (e.g. WeatherGPT or registered alphanumeric/virtual number)
SMS_SENDER_ID=WeatherGPT

# ---------------------------------------------------------------------------
# 5. Vonage Delivery Receipt (DLR) Webhook Configuration
# ---------------------------------------------------------------------------
# Configure these when enabling cryptographic signature validation for incoming
# delivery receipts at: POST /api/webhooks/vonage/delivery-receipt
# VONAGE_SIGNATURE_SECRET: Webhook secret configured in your Vonage dashboard
VONAGE_SIGNATURE_SECRET=
# VONAGE_SIGNATURE_METHOD: sha256 (recommended), sha512, md5, or sha1
VONAGE_SIGNATURE_METHOD=sha256
