# ============================================================
# WeatherGPT Environment Configuration
# ============================================================


# ============================================================
# WEATHER SOURCE CONFIGURATION
# ============================================================

# mock = use deterministic SIH demo weather
# live = use live Open-Meteo weather
WEATHER_MODE=mock


# ============================================================
# IMD INTEGRATION
# ============================================================

# Keep false until official IMD API access is approved
IMD_ENABLED=false

# Add these only after you receive IMD API access
IMD_API_BASE_URL=
IMD_API_KEY=

# Optional IMD station configuration
IMD_STATION_ID=


# ============================================================
# CALENDAR CONFIGURATION
# ============================================================

# mock = safe local calendar for development/testing
# google = use Google Calendar API
CALENDAR_MODE=mock

# Google Calendar configuration
# Only required when CALENDAR_MODE=google
GOOGLE_CALENDAR_ID=primary
GOOGLE_APPLICATION_CREDENTIALS=


# ============================================================
# SMS / VONAGE CONFIGURATION
# ============================================================

# Set true to enable live Vonage SMS dispatch
SMS_ENABLED=true

# SMS provider: vonage | simulated
SMS_PROVIDER=vonage

# Vonage (Nexmo) API credentials
VONAGE_API_KEY=be7fe5a8
VONAGE_API_SECRET=G1C3T^Li2ieL*
VONAGE_FROM=WeatherGPT

# Optional destination phone number override for manual testing
VONAGE_TO=9934768317


# ============================================================
# APPLICATION CONFIGURATION
# ============================================================

# Application environment
APP_ENV=development

# Application name
APP_NAME=WeatherGPT

# Application timezone
TIMEZONE=Asia/Kolkata


# ============================================================
# FUTURE CONFIGURATION
# ============================================================

# DATABASE_URL=
# SUPABASE_URL=
# SUPABASE_KEY=
# OPENAI_API_KEY=
# RADIO_GPT_ENABLED=false