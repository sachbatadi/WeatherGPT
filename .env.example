# ===========================================================================
# WeatherGPT Environment Configuration Template (.env.example)
# ===========================================================================
# Copy this file to '.env' and modify variables to customize runtime behavior:
#   cp .env.example .env
# ===========================================================================

# ---------------------------------------------------------------------------
# 1. System Execution Mode
# ---------------------------------------------------------------------------
# WEATHER_MODE:
#   'mock' : Uses deterministic SIH disaster presets (Jalandhar Heavy Rain,
#            Bathinda High Wind, Amritsar Heatwave). Ideal for offline hackathon demos.
#   'live' : Connects to Open-Meteo live API for real-time global weather.
WEATHER_MODE=live

# CALENDAR_PROVIDER:
#   'mock'   : In-memory calendar simulator (no Google credentials needed).
#   'google' : Synchronizes real events via Google Calendar API.
CALENDAR_PROVIDER=live

# Default starting location (e.g. Jalandhar, Bathinda, Amritsar, Ludhiana)
DEFAULT_LOCATION=Jalandhar

# Log verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO


# ---------------------------------------------------------------------------
# 2. Agronomic Hazard Thresholds (Optional overrides)
# ---------------------------------------------------------------------------
# RAIN_CRITICAL_MM=50.0
# RAIN_HIGH_MM=25.0
# RAIN_MEDIUM_MM=12.0
# WIND_SPRAY_LIMIT_KMH=15.0
# HEAT_STRESS_C=38.0
# FROST_HIGH_C=4.0


# ---------------------------------------------------------------------------
# 3. External Integration Credentials (Required only if live mode is enabled)
# ---------------------------------------------------------------------------
# Google Calendar API service account JSON path
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CALENDAR_ID=primary

# Database Connection URL (Member 6)
DATABASE_URL=sqlite:///./weathergpt.db

# Optional Conversational AI API Keys (e.g. Google Gemini)
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# 4. Vonage SMS & Radio-GPT Alerts
# ---------------------------------------------------------------------------
VONAGE_APPLICATION_ID=your-vonage-application-id
VONAGE_PRIVATE_KEY_PATH=private.key
VONAGE_SMS_SENDER_ID=WeatherGPT
RADIO_PUBLIC_URL=https://your-ngrok-domain.ngrok-free.dev
